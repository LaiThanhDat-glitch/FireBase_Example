<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

  <!-- ID Label & Input -->
  <TextView
      android:id="@+id/tvIdLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="60dp"
      android:text="ID:"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <EditText
      android:id="@+id/etId"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="24dp"
      android:hint="Nhập ID bài viết (vd: art_01)"
      android:inputType="text"
      app:layout_constraintBaseline_toBaselineOf="@+id/tvIdLabel"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/tvCoverLabel" />

  <!-- Title Label & Input -->
  <TextView
      android:id="@+id/tvTitleLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="24dp"
      android:text="Title:"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvIdLabel" />

  <EditText
      android:id="@+id/etTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="24dp"
      android:hint="Nhập tiêu đề"
      android:inputType="text"
      app:layout_constraintBaseline_toBaselineOf="@+id/tvTitleLabel"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/tvCoverLabel" />

  <!-- Content Label & Input -->
  <TextView
      android:id="@+id/tvContentLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="24dp"
      android:text="Content:"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvTitleLabel" />

  <EditText
      android:id="@+id/etContent"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="24dp"
      android:hint="Nhập nội dung"
      android:inputType="textMultiLine"
      app:layout_constraintBaseline_toBaselineOf="@+id/tvContentLabel"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/tvCoverLabel" />

  <!-- Cover Image Label & Input -->
  <TextView
      android:id="@+id/tvCoverLabel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="24dp"
      android:text="Img Cover:"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/tvContentLabel" />

  <EditText
      android:id="@+id/etImgCover"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="24dp"
      android:hint="Tên ảnh trong drawable (vd: news1)"
      android:inputType="text"
      app:layout_constraintBaseline_toBaselineOf="@+id/tvCoverLabel"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/tvCoverLabel" />

  <!-- Action Buttons -->
  <Button
      android:id="@+id/btAdd"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="36dp"
      android:text="Add"
      app:layout_constraintEnd_toStartOf="@+id/btShow"
      app:layout_constraintHorizontal_chainStyle="packed"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/etImgCover" />

  <Button
      android:id="@+id/btShow"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="32dp"
      android:text="Show DB"
      app:layout_constraintBottom_toBottomOf="@+id/btAdd"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/btAdd"
      app:layout_constraintTop_toTopOf="@+id/btAdd" />

</androidx.constraintlayout.widget.ConstraintLayout>